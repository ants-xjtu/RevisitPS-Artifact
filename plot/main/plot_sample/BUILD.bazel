load("@my_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
package(default_visibility = ["//visibility:public"])

py_binary(
    name = "plot",
    srcs = ["plot.py"],
    deps = [
        "//lib/py/plot",
        requirement("numpy"),
        requirement("pandas"),
        requirement("matplotlib"),
    ],
)

