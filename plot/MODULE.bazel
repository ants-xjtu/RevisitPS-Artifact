module(
    name = "your_project_name",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "0.31.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = "3.12",
)
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.11",
)
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.10",
)

use_repo(python, "python_versions")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# 为不同 Python 版本解析相同的 requirements_lock
pip.parse(
    hub_name = "my_deps",
    python_version = "3.12",
    requirements_lock = "//third_party/py:requirements_lock.txt",
    extra_pip_args = ["--index-url", "https://pypi.tuna.tsinghua.edu.cn/simple"],
)
pip.parse(
    hub_name = "my_deps",
    python_version = "3.11",
    requirements_lock = "//third_party/py:requirements_lock.txt",
    extra_pip_args = ["--index-url", "https://pypi.tuna.tsinghua.edu.cn/simple"],
)
pip.parse(
    hub_name = "my_deps",
    python_version = "3.10",
    requirements_lock = "//third_party/py:requirements_lock.txt",
    extra_pip_args = ["--index-url", "https://pypi.tuna.tsinghua.edu.cn/simple"],
)

use_repo(pip, "my_deps")

# Hedron compile commands extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "daae6f40adfa5fdb7c89684cbe4d88b691c63b2d",
)
